{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["vite/client"], "resolveJsonModule": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"], "@providers/*": ["providers/*"], "@hosts/*": ["hosts/*"] }
  },
  "include": ["src", "providers", "hosts"], "exclude": ["hosts/cooldash/ext", "**/*.test.ts"]
}
