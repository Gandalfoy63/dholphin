# Copy to docker/.env and fill in. Never commit docker/.env.
DHOLPHIN_DOMAIN=dholphin.example.com
TRAEFIK_RESOLVER=coolroom
TRAEFIK_NETWORK=ezt
DHOLPHIN_PORT=8080
# Behind a reverse proxy that doesn't send X-Forwarded-Proto and -Host: the address people open, with its path if any.
# PUBLIC_URL=https://tv.example.com
# The image: the published one, or dholphin:latest after tools/build_server.sh.
DHOLPHIN_IMAGE=gandasdevstudio/dholphin:latest
